NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_OAUTH_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_OAUTH_APPLE_CLIENT_ID=
# Set to "staging" only on the staging deployment's env vars in Vercel.
NEXT_PUBLIC_APP_ENV=
# Server-side, read at build time by next.config.mjs. "1" turns Next.js image optimization off
# app-wide (set it on staging to avoid optimizer-quota spend). Changing it needs a redeploy.
DISABLE_IMAGE_OPTIMIZATION=
# Public origin used for canonical URLs, hreflang alternates, the sitemap and share previews.
NEXT_PUBLIC_SITE_URL=https://www.storywall.gr
# Server-only secret, never NEXT_PUBLIC_. Same value as the backend's CLIENT_IP_FORWARDING_SECRET;
# lets Spring rate-limit login/register/refresh per browser instead of per this server's address.
# Generate with: openssl rand -hex 32. Empty = not forwarded.
CLIENT_IP_FORWARDING_SECRET=
# Server-side, read at build time by next.config.mjs. Comma-separated hosts the backend's media
# URLs come from — for R2, "<account-id>.r2.cloudflarestorage.com" (the account in the backend's
# R2_ENDPOINT), plus the demo bucket's public host (the backend's R2_PUBLIC_BASE_URL) when set.
# next/image rejects any other host with a 400. Required for production builds.
MEDIA_IMAGE_HOSTS=
# Google Ads tag id (AW-...). Set only on the production deployment in Vercel: it turns on the cookie
# banner's Advertising tag and allows Google's origins in the CSP. Read at build time; changing it needs a redeploy.
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Google Analytics 4 measurement id (G-...). Set only on the production deployment in Vercel: it turns on the
# cookie banner's Analytics tag and allows Google Analytics' origins in the CSP. Read at build time; needs a redeploy.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Sentry error tracking (org storywall, project storywall-web, set in next.config.mjs). Empty DSN = Sentry
# off (local dev). Set the DSN on Production and the staging deployment in Vercel; the environment tag comes
# from NEXT_PUBLIC_APP_ENV, else Vercel's environment.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for uploading source maps. Server-only secret, never NEXT_PUBLIC_. Empty = no upload.
SENTRY_AUTH_TOKEN=
