NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_OAUTH_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_OAUTH_APPLE_CLIENT_ID=
# Set to "staging" only on the staging deployment's env vars in Vercel.
# Skips Next.js image optimization for remote (BE-served) images there to avoid optimizer-quota spend.
NEXT_PUBLIC_APP_ENV=
# Public origin used for canonical URLs, hreflang alternates, the sitemap and share previews.
NEXT_PUBLIC_SITE_URL=https://www.storywall.gr
# Server-only secret, never NEXT_PUBLIC_. Same value as the backend's CLIENT_IP_FORWARDING_SECRET;
# lets Spring rate-limit login/register/refresh per browser instead of per this server's address.
# Generate with: openssl rand -hex 32. Empty = not forwarded.
CLIENT_IP_FORWARDING_SECRET=
